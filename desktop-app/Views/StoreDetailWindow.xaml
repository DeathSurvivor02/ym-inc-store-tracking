<Window x:Class="YMInc.StoreDeploymentApp.Views.StoreDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Deployment &amp; Engineering Specification (Editable)"
        Height="730" Width="920"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Store Header Banner (Editable Status & Health) -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Banner Badge -->
                <Border Grid.Column="0" Width="52" Height="52" Background="#1E3A8A" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerCodeBadge" Text="BN" Foreground="#93C5FD" FontSize="18" FontWeight="Black" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Store Names & Location -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock x:Name="StoreNumberText" Text="Store #6142" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock x:Name="CountryFlagText" Text="🇨🇦" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="Health:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox x:Name="HealthCombo" Width="130" Height="26" SelectionChanged="HealthCombo_SelectionChanged">
                            <ComboBoxItem Content="On Track" Tag="On Track"/>
                            <ComboBoxItem Content="At Risk" Tag="At Risk"/>
                            <ComboBoxItem Content="Critical Blocker" Tag="Critical Blocker"/>
                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="Store Name: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBox x:Name="StoreNameTextBox" Width="260" Height="25" Margin="0,0,12,0"/>
                        <TextBlock Text="Mall: " FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StoreMallText" Text="Yorkdale Shopping Centre" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Target Date & Stage -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,4">
                        <TextBlock Text="Target Open: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <TextBox x:Name="TargetDateTextBox" Width="110" Height="25" FontWeight="Bold" Foreground="#38BDF8"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Status: " FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                        <ComboBox x:Name="OperationalStatusCombo" Width="150" Height="26">
                            <ComboBoxItem Content="Grand Open"/>
                            <ComboBoxItem Content="Fixturing"/>
                            <ComboBoxItem Content="Low-Voltage Cabling"/>
                            <ComboBoxItem Content="Site Survey"/>
                            <ComboBoxItem Content="Active Fleet"/>
                            <ComboBoxItem Content="Store Closure"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Technical Specification Tabs (All Editable) -->
        <TabControl Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B">
            
            <!-- TAB 1: SITE SURVEY -->
            <TabItem Header="📋 Site Survey Specs" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Structural &amp; Demarcation Specifications" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Left Column -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ceiling Type:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyCeilingTypeTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Clear Deck Height (Feet):" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyCeilingHeightTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Survey Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SurveyStatusCombo" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Completed &amp; Approved"/>
                                    <ComboBoxItem Content="Scheduled"/>
                                    <ComboBoxItem Content="In Progress"/>
                                    <ComboBoxItem Content="Pending Vendor"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Right Column -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Demarc Location:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyDemarcLocationTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Demarc Conduit Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SurveyConduitCombo" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Clear &amp; Available (Ready)" Tag="True"/>
                                    <ComboBoxItem Content="Blocked / Missing (Requires Riser Work)" Tag="False"/>
                                </ComboBox>

                                <TextBlock Text="Surveyor Name &amp; Vendor:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyorTextBox" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: POWER POLES -->
            <TabItem Header="⚡ Wiremold Power Poles" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Wiremold 25DTP-4 Cash Wrap Dual-Channel Feeds" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Installation Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PowerPoleStatusCombo" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Fully Installed &amp; Certified"/>
                                    <ComboBoxItem Content="Delivered On Site"/>
                                    <ComboBoxItem Content="In Progress"/>
                                    <ComboBoxItem Content="Survey Required"/>
                                    <ComboBoxItem Content="Blocked / On Hold"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Poles Installed:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PowerPoleInstalledTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Total Required:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PowerPoleTotalTextBox"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Finish Color:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleColorTextBox" Margin="0,0,0,10"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ceiling Mount Type:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleMountTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Cash Wrap Drops:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleDropsTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Electrical Contractor:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleContractorTextBox" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Blocker Alert / Notes:" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="PowerPoleBlockerTextBox" Height="45" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: CABLING -->
            <TabItem Header="🔌 Low-Voltage Cabling" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Cat6 Plenum Structured Cabling Matrix" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cabling Status:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CablingStatusCombo" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Fluke Certified &amp; Closed"/>
                                    <ComboBoxItem Content="Pathway &amp; J-Hooks Installed"/>
                                    <ComboBoxItem Content="Rough-In In Progress"/>
                                    <ComboBoxItem Content="Vendor Assigned"/>
                                    <ComboBoxItem Content="Blocked"/>
                                </ComboBox>

                                <TextBlock Text="Total Data Drops:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingTotalDropsTextBox" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="POS Drops:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CablingPosDropsTextBox"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="AP Wireless Drops:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CablingApDropsTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fluke Test Certification:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CablingFlukeCombo" Margin="0,0,0,10">
                                    <ComboBoxItem Content="✓ Certified &amp; Passed" Tag="True"/>
                                    <ComboBoxItem Content="Pending Fluke Certification" Tag="False"/>
                                </ComboBox>

                                <TextBlock Text="Cabling Contractor / Vendor:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingVendorTextBox" Margin="0,0,0,10"/>

                                <TextBlock Text="Lead Field Technician:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingTechTextBox" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: TELECOM WAN -->
            <TabItem Header="📡 Telecom WAN Circuits" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Dual-WAN Carrier Circuit Details" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CircuitsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding CarrierName}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ServiceType}" FontSize="11" Foreground="#CBD5E1"/>
                                                <TextBlock FontSize="10" Foreground="#94A3B8">
                                                    <Run Text="Speed: "/><Run Text="{Binding BandwidthDownMbps}" FontWeight="Bold" Foreground="#34D399"/><Run Text=" ↓ / "/><Run Text="{Binding BandwidthUpMbps}" FontWeight="Bold" Foreground="#60A5FA"/><Run Text=" ↑ Mbps"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding JeopardyReason}" FontSize="10" Foreground="#F87171" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <Border Background="#0F172A" Padding="8,4" CornerRadius="4">
                                                    <TextBlock Text="{Binding OrderStatus}" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: MALL RULES -->
            <TabItem Header="🏢 Mall Landlord Rules" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="MallNameHeading" Text="Mall Landlord Compliance Rules" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left column: COI & After Hours -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Certificate of Insurance (COI):" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallCoiRequiredText" Text="Required (Yes)" FontSize="13" FontWeight="Bold" Foreground="#34D399" Margin="0,2,0,12"/>

                                    <TextBlock Text="After Hours Work Requirement:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallAfterHoursText" Text="Daytime Permitted (No)" FontSize="13" FontWeight="Bold" Foreground="#94A3B8" Margin="0,2,0,12"/>

                                    <TextBlock Text="Delivery Window:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallDeliveryText" Text="06:00 - 09:00" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,12"/>
                                </StackPanel>

                                <!-- Right column: Liability, Badging, Landlord -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Landlord Management Company:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallLandlordCompanyText" Text="Oxford Properties" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,12"/>

                                    <TextBlock Text="Minimum General Liability Amount:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallLiabilityText" Text="$10,000,000 CAD" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,12"/>

                                    <TextBlock Text="Security Badging Fee per Tech:" FontSize="11" Foreground="#94A3B8"/>
                                    <TextBlock x:Name="MallBadgingText" Text="$25 CAD" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,12"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mall Management & Operations Contact Details -->
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Mall Management &amp; Operational Contacts" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Contact Name:" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="MallContactNameText" Text="Mall Operations Office" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,10"/>
                                        <TextBlock Text="Operations Phone:" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="MallContactPhoneText" Text="N/A" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Operations Email:" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="MallContactEmailText" Text="operations@mall.com" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,10"/>
                                        <TextBlock Text="Security Dispatch Phone:" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="MallSecurityPhoneText" Text="N/A" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Special Mall Rules &amp; Access Notes:" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBlock x:Name="MallSpecialRulesText" Text="Security office check-in 30 mins prior to delivery window." 
                                       FontSize="11" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Content="⚙️ Open Full Mall Directory &amp; Edit Form" Click="OpenMallDirectoryButton_Click"
                                Background="#1E293B" Foreground="#38BDF8" FontWeight="SemiBold" Width="260" Height="32" 
                                HorizontalAlignment="Left" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer with Save & Close -->
        <Border Grid.Row="2" Background="#0F172A" Padding="14,10" Margin="0,12,0,0" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SaveNotificationText" Grid.Column="0" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Save Store Updates" Click="SaveButton_Click"
                            Width="160" Height="32" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>
                    <Button Content="Close" Click="CloseButton_Click" 
                            Width="90" Height="32" Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

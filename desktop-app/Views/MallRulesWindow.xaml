<Window x:Class="YMInc.StoreDeploymentApp.Views.MallRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mall Landlord Compliance &amp; Requirements Directory"
        Height="720" Width="1160"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#0F172A"/>
                        <Setter Property="Foreground" Value="#F8FAFC"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏢 Commercial Retail Mall Requirements Directory" FontSize="17" FontWeight="Bold" Foreground="White" Margin="0,0,10,0"/>
                        <Border Background="#1E3A8A" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Interactive Form" FontSize="10" FontWeight="Bold" Foreground="#93C5FD"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Manage Certificate of Insurance (COI) mandates, after-hours requirements, loading dock delivery windows, and security badging protocols." 
                               FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ Add New Mall" Click="AddNewMallButton_Click" 
                            Background="#2563EB" Foreground="White" FontWeight="SemiBold" 
                            Padding="12,6" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Master-Detail Split Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Directory List & Filter -->
            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged"
                                 Margin="0,0,8,0" Tag="Search by mall, code, landlord, city..."/>

                        <ComboBox x:Name="CountryFilterCombo" Grid.Column="1" Width="110" SelectionChanged="CountryFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="All Regions" Tag="ALL" IsSelected="True"/>
                            <ComboBoxItem Content="🇨🇦 Canada" Tag="CA"/>
                            <ComboBoxItem Content="🇺🇸 United States" Tag="US"/>
                        </ComboBox>
                    </Grid>

                    <!-- Malls DataGrid -->
                    <DataGrid x:Name="MallsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              Background="#0B0F17" RowBackground="#0B0F17" AlternatingRowBackground="#111827"
                              BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2937"
                              Foreground="#E2E8F0" FontSize="11" SelectionMode="Single"
                              SelectionChanged="MallsGrid_SelectionChanged"
                              HeadersVisibility="Column" CanUserResizeRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1E293B"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,8"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#334155"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mall Code" Binding="{Binding MallCode}" Width="85"/>
                            <DataGridTextColumn Header="Property Name" Binding="{Binding PropertyName}" Width="1.5*"/>
                            <DataGridTextColumn Header="Landlord" Binding="{Binding LandlordCompany}" Width="1.1*"/>
                            <DataGridTextColumn Header="Country" Binding="{Binding CountryCode}" Width="55"/>
                            
                            <!-- COI Required Column -->
                            <DataGridTemplateColumn Header="COI Req." Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#064E3B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CoiRequired}" Value="False">
                                                            <Setter Property="Background" Value="#1E293B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding CoiDisplay}" FontWeight="Bold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#34D399"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CoiRequired}" Value="False">
                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- After Hours Required Column -->
                            <DataGridTemplateColumn Header="After Hours" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E293B"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NightWorkOnly}" Value="True">
                                                            <Setter Property="Background" Value="#451A03"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding AfterHoursDisplay}" FontWeight="Bold" FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NightWorkOnly}" Value="True">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Delivery Window" Binding="{Binding DeliveryWindow}" Width="95"/>
                            <DataGridTextColumn Header="Badging" Binding="{Binding BadgingFeePerTech, StringFormat={}${0:F0}}" Width="65"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="CountSummaryText" Grid.Row="2" Text="Showing 15 Mall Properties" 
                               FontSize="11" Foreground="#64748B" Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT PANE: Mall Requirements Form -->
            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Form Title -->
                        <Border Background="#1E293B" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="FormHeaderTitle" Text="Mall Requirements Specification" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="FormHeaderSubtitle" Text="Select a mall from the directory or click '+ Add New Mall' to create one." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- FORM FIELDS -->
                        <!-- Row 1: Mall Code & Country -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mall Code:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="FormMallCodeText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Country:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormCountryCombo">
                                    <ComboBoxItem Content="🇨🇦 Canada (CA)" Tag="CA" IsSelected="True"/>
                                    <ComboBoxItem Content="🇺🇸 United States (US)" Tag="US"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Property Name -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Property Name:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="FormPropertyNameText"/>
                        </StackPanel>

                        <!-- Row 3: Landlord Company & Property Type -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Landlord Company:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="FormLandlordText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Property Type:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <ComboBox x:Name="FormPropertyTypeCombo">
                                    <ComboBoxItem Content="Enclosed Regional Mall" IsSelected="True"/>
                                    <ComboBoxItem Content="Power Centre / Strip Mall"/>
                                    <ComboBoxItem Content="Outlet Centre"/>
                                    <ComboBoxItem Content="Street Front Flagship"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Row 4: City & State/Province -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="FormCityText"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province / State:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                <TextBox x:Name="FormStateProvinceText"/>
                            </StackPanel>
                        </Grid>
 
                        <!-- Mall Management & Contact Details -->
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Mall Management &amp; Operational Contacts" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Contact Name:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormContactNameText"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Operations Phone:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormContactPhoneText"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Email:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormContactEmailText"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Security Dispatch Phone:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormSecurityPhoneText"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- MANDATES & PROTOCOLS SECTION (COI & After Hours) -->
                        <Border Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Deployment Protocols &amp; Mandates" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <!-- COI & After Hours Switches -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- COI REQUIRED -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="COI Required:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="FormCoiCombo">
                                            <ComboBoxItem Content="Yes - Certificate Required" Tag="True" IsSelected="True"/>
                                            <ComboBoxItem Content="No - Exempt" Tag="False"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- AFTER HOURS REQUIRED -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="After Hours Required:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <ComboBox x:Name="FormAfterHoursCombo">
                                            <ComboBoxItem Content="Yes - Night Shift Only" Tag="True"/>
                                            <ComboBoxItem Content="No - Daytime Permitted" Tag="False" IsSelected="True"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Delivery Window & Min Liability -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Delivery Window:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormDeliveryWindowText" Text="06:00 - 09:30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min. General Liability ($):" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                        <TextBox x:Name="FormLiabilityText" Text="5000000"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Badging Fee -->
                                <StackPanel>
                                    <TextBlock Text="Security Badging Fee per Tech ($):" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                    <TextBox x:Name="FormBadgingFeeText" Text="25.00"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Special Rules / Notes -->
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="Special Rules &amp; Access Notes:" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                            <TextBox x:Name="FormSpecialRulesText" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <!-- Action Feedback Message -->
                        <TextBlock x:Name="FormStatusText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" Margin="0,0,0,8" HorizontalAlignment="Center"/>

                        <!-- Save & Cancel Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="💾 Save Requirements" Click="SaveButton_Click" 
                                    Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="12"
                                    Width="160" Height="34" BorderThickness="0" Cursor="Hand" Margin="0,0,8,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F172A" Padding="12,8" Margin="0,12,0,0" CornerRadius="6">
            <Button Content="Close Directory" Click="CloseButton_Click" HorizontalAlignment="Right"
                    Width="130" Height="30" Background="#334155" Foreground="White" FontWeight="SemiBold" 
                    BorderThickness="0" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>

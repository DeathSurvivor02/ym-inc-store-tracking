<Window x:Class="YMInc.StoreDeploymentApp.Views.FiscalCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NRF 4-5-4 Retail Fiscal Calendar — YM Inc."
        Height="720" Width="1050"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Filters & Search -->
            <RowDefinition Height="*"/>    <!-- DataGrid -->
            <RowDefinition Height="Auto"/> <!-- Status & Close -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#2563EB" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="📅" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NRF 4-5-4 Retail Fiscal Calendar" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="FY2025 – FY2027" FontSize="9" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Retail accounting 4-5-4 periods, weeks, commercial holidays &amp; peak deployment freeze dates" 
                                   FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Current Active Context -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="6" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Current Period: " FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="FY2026 Wk 41 / Wk 42 (Q3)" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- FILTERS & CONTROLS -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Year -->
                    <ColumnDefinition Width="Auto"/> <!-- Quarter -->
                    <ColumnDefinition Width="Auto"/> <!-- Holiday Only Check -->
                    <ColumnDefinition Width="*"/>    <!-- Search -->
                    <ColumnDefinition Width="Auto"/> <!-- Count Badge -->
                </Grid.ColumnDefinitions>

                <!-- Fiscal Year Combo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Fiscal Year:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="YearFilterCombo" SelectionChanged="Filter_Changed"
                              Height="28" Width="135" Background="#1E293B" Foreground="White" BorderBrush="#334155" FontSize="11">
                        <ComboBoxItem Content="All Years (2025–2027)" Tag="ALL"/>
                        <ComboBoxItem Content="Fiscal 2025" Tag="2025"/>
                        <ComboBoxItem Content="Fiscal 2026 (Active)" Tag="2026" IsSelected="True"/>
                        <ComboBoxItem Content="Fiscal 2027" Tag="2027"/>
                    </ComboBox>
                </StackPanel>

                <!-- Quarter Combo -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Quarter:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="QuarterFilterCombo" SelectionChanged="Filter_Changed"
                              Height="28" Width="105" Background="#1E293B" Foreground="White" BorderBrush="#334155" FontSize="11">
                        <ComboBoxItem Content="All (Q1–Q4)" Tag="ALL" IsSelected="True"/>
                        <ComboBoxItem Content="Quarter 1 (Q1)" Tag="1"/>
                        <ComboBoxItem Content="Quarter 2 (Q2)" Tag="2"/>
                        <ComboBoxItem Content="Quarter 3 (Q3)" Tag="3"/>
                        <ComboBoxItem Content="Quarter 4 (Q4)" Tag="4"/>
                    </ComboBox>
                </StackPanel>

                <!-- Retail Holidays Toggle -->
                <CheckBox x:Name="HolidaysOnlyCheckBox" Grid.Column="2" Content="⭐ Retail Holidays Only" 
                          Checked="Filter_Changed" Unchecked="Filter_Changed"
                          Foreground="#F59E0B" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" Cursor="Hand"/>

                <!-- Search Input -->
                <TextBox x:Name="SearchBox" Grid.Column="3" TextChanged="SearchBox_TextChanged"
                         Height="28" Background="#1E293B" Foreground="White" BorderBrush="#334155"
                         Padding="8,4" FontSize="11" VerticalContentAlignment="Center"
                         ToolTip="Search by holiday (e.g. Black Friday, Boxing Day), month, week number, or calendar date..."/>

                <!-- Record Count Badge -->
                <Border Grid.Column="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="10,0,0,0">
                    <TextBlock x:Name="RecordCountText" Text="Loading dates..." FontSize="11" FontWeight="Bold" Foreground="#34D399"/>
                </Border>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <DataGrid x:Name="CalendarDataGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                  BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                  Foreground="#E2E8F0" FontSize="11" SelectionMode="Single"
                  HeadersVisibility="Column" CanUserResizeRows="False">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#1E293B"/>
                    <Setter Property="Foreground" Value="#94A3B8"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    <Setter Property="BorderBrush" Value="#334155"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Calendar Date" Binding="{Binding DateDisplay}" Width="110"/>
                <DataGridTextColumn Header="Day of Week" Binding="{Binding DayOfWeekName}" Width="100"/>
                <DataGridTextColumn Header="Fiscal Year" Binding="{Binding FiscalYear}" Width="85"/>
                <DataGridTextColumn Header="Quarter" Binding="{Binding QuarterDisplay}" Width="75"/>
                <DataGridTextColumn Header="4-5-4 Retail Period" Binding="{Binding PeriodDisplay}" Width="130"/>
                <DataGridTextColumn Header="Fiscal Week" Binding="{Binding WeekDisplay}" Width="90"/>
                <DataGridTextColumn Header="Day #" Binding="{Binding DayOfFiscalWeek}" Width="65"/>
                
                <!-- Retail Holiday Highlight Column -->
                <DataGridTemplateColumn Header="Retail Holiday / Key Event" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,2">
                                <Border Background="#78350F" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                        Visibility="{Binding IsHoliday, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="⭐ HOLIDAY" FontSize="9" FontWeight="Black" Foreground="#FDE047"/>
                                </Border>
                                <TextBlock Text="{Binding HolidayDisplay}" FontSize="11" FontWeight="SemiBold" 
                                           Foreground="{Binding HolidayStatusColor}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- FOOTER & CLOSE BUTTON -->
        <Border Grid.Row="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="12,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="● Live NRF 4-5-4 Retail Fiscal Calendar synchronized with Neon PostgreSQL." 
                           FontSize="11" Foreground="#10B981" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Close Calendar" Click="CloseButton_Click"
                        Height="28" Padding="18,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>
            </Grid>
        </Border>

    </Grid>
</Window>

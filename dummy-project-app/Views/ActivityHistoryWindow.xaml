<Window x:Class="YMInc.StoreDeploymentApp.Views.ActivityHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Operator Change History &amp; Save Audit Log — YM Inc."
        Height="780" Width="1340"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Microsoft 365 App Bar -->
            <RowDefinition Height="Auto"/> <!-- Command & KPI Ribbon -->
            <RowDefinition Height="*"/>    <!-- Master-Detail History Grid + Diff Inspector -->
            <RowDefinition Height="26"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: MICROSOFT 365 APP BAR ==================== -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="14,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YM Inc. Store Rollout Manager" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                    <TextBlock Text="|" Foreground="#7FBEF2" Margin="0,0,10,0"/>
                    <TextBlock x:Name="HeaderSubtitleText" Text="Operator Change History &amp; Save Audit Log" FontSize="12.5" Foreground="#EBF3FC"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="LastSavedHeaderBadge" Text="Last Saved: Just now" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#EBF3FC" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ThemeToggleButton" Content="🌙 Dark Theme" Click="ThemeToggleButton_Click" Padding="9,2" FontSize="11" Height="24"
                            ToolTip="Switch between Microsoft Light and Dark Theme"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ==================== ROW 1: FILTER & COMMAND RIBBON ==================== -->
        <Border Grid.Row="1" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Category:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CategoryFilterCombo" Width="185" MinHeight="32" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Change Categories" Tag="ALL" IsSelected="True"/>
                        <ComboBoxItem Content="Inline Grid Edits" Tag="Inline Grid Edit"/>
                        <ComboBoxItem Content="Store Specifications" Tag="Store Specification"/>
                        <ComboBoxItem Content="Landlord Compliance" Tag="Landlord Compliance"/>
                        <ComboBoxItem Content="Daily Schedule / TTU" Tag="Daily Schedule"/>
                        <ComboBoxItem Content="Manual Save Checkpoints" Tag="System Save"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Store Filter:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="StoreFilterBox" Width="110" MinHeight="32" TextChanged="Filter_Changed"
                             FontFamily="{StaticResource MonoFont}" ToolTip="Filter by Store # (e.g. 0002) or leave blank for all"/>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="2" MinHeight="32" Margin="0,0,12,0" TextChanged="Filter_Changed"
                         ToolTip="Search by operator, store, mall, field name, old value, or new value..."/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Export History (CSV)..." Click="ExportCsvButton_Click" MinHeight="32" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="Refresh" Click="RefreshButton_Click" MinHeight="32" Padding="12,0" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}" MinHeight="32" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 2: MASTER-DETAIL HISTORY TABLE + DIFF INSPECTOR ==================== -->
        <Grid Grid.Row="2" Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Change Log DataGrid -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                        <DockPanel>
                            <TextBlock Text="CHRONOLOGICAL CHANGE &amp; SAVE LOG" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="EntryCountBadge" Text="0 Entries" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="#0F6CBD" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="HistoryDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              BorderThickness="0" SelectionChanged="HistoryDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding TimestampDisplay}" Width="145" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="OPERATOR" Binding="{Binding OperatorDisplay}" Width="135" FontWeight="SemiBold"/>
                            <DataGridTemplateColumn Header="CATEGORY" Width="145">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CategoryBadgeBg}" CornerRadius="2" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Category}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding CategoryBadgeFg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="TARGET RECORD" Binding="{Binding TargetRecord}" Width="185" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="FIELD / ACTION" Binding="{Binding FieldName}" Width="150" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="PREVIOUS VALUE" Binding="{Binding PreviousValue}" Width="130"/>
                            <DataGridTextColumn Header="NEW VALUE" Binding="{Binding NewValue}" Width="130" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT: Selected Change Inspector (Before vs After Diff) -->
            <Border Grid.Column="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="CHANGE DIFF INSPECTOR" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD"/>
                            <TextBlock x:Name="DetailTargetText" Text="Select a History Entry" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,1" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailMetaText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,12">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Field / Action:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock x:Name="DetailFieldText" Grid.Column="1" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="PREVIOUS VALUE (BEFORE EDIT)" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,12">
                                <TextBlock x:Name="DetailOldValueText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="NEW SAVED VALUE (AFTER EDIT)" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#15803D" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="#15803D" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,14">
                                <TextBlock x:Name="DetailNewValueText" Text="—" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <TextBlock Text="AUDIT LOG SUMMARY" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                                <TextBlock x:Name="DetailSummaryText" Text="—" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ROW 3: STATUS BAR ==================== -->
        <Border Grid.Row="3" Background="#0078D4" Padding="14,0">
            <DockPanel>
                <TextBlock x:Name="FooterStatusText" Text="Ready — All user edits and manual saves are automatically logged." FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="YM Inc. Audit &amp; Compliance Trail" FontSize="11" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

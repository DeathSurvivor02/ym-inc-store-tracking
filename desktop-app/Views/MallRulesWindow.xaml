<Window x:Class="YMInc.StoreDeploymentApp.Views.MallRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mall Landlord Compliance Directory"
        Height="550" Width="750"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Commercial Retail Landlord Rules Directory" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Union labor mandates, general liability requirements, and security badging protocols." FontSize="11" Foreground="#94A3B8"/>
        </StackPanel>

        <DataGrid x:Name="MallsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                  BorderBrush="#334155" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                  Foreground="#E2E8F0" FontSize="11" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mall Code" Binding="{Binding MallCode}" Width="80"/>
                <DataGridTextColumn Header="Property Name" Binding="{Binding PropertyName}" Width="180"/>
                <DataGridTextColumn Header="Landlord Company" Binding="{Binding LandlordCompany}" Width="140"/>
                <DataGridTextColumn Header="Country" Binding="{Binding CountryCode}" Width="60"/>
                <DataGridTemplateColumn Header="Union Labor" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UnionLaborRequired, Converter={x:Null}}" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Open Shop"/>
                                        <Setter Property="Foreground" Value="#34D399"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnionLaborRequired}" Value="True">
                                                <Setter Property="Text" Value="MANDATORY UNION"/>
                                                <Setter Property="Foreground" Value="#F87171"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Delivery Window" Binding="{Binding DeliveryWindow}" Width="90"/>
                <DataGridTextColumn Header="Badging Fee" Binding="{Binding BadgingFeePerTech, StringFormat={}${0:F0}}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Close Directory" Click="CloseButton_Click" HorizontalAlignment="Right"
                Width="120" Height="32" Background="#334155" Foreground="White" FontWeight="SemiBold" 
                BorderThickness="0" Margin="0,12,0,0" Cursor="Hand"/>
    </Grid>
</Window>

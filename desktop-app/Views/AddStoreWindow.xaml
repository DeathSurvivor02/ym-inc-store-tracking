<Window x:Class="YMInc.StoreDeploymentApp.Views.AddStoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add New Store Deployment — YM Inc."
        Height="640" Width="680"
        MinHeight="560" MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Background="#FAF9F8"
        Foreground="#201F1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Microsoft App Header -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏬 " FontSize="14" Foreground="#FFFFFF"/>
                    <TextBlock Text="Add New Retail Store Deployment" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </StackPanel>
                <Border x:Name="AddStoreModeBadge" Background="#0C5596" BorderBrush="#62ABF5" BorderThickness="1" CornerRadius="2" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="AddStoreModeBadgeText" Text="PRODUCTION DB" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Form Body (Scrollable) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <!-- Instructions Banner -->
                <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Padding="14,10" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Register a new retail storefront into the deployment fleet." FontSize="12.5" FontWeight="SemiBold" Foreground="#111827" Margin="0,0,0,3"/>
                        <TextBlock Text="Enter store identity, location, milestones, and initial infrastructure specifications. Initial survey and cabling work items will be auto-generated." FontSize="11.5" Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- SECTION 1: STORE & BRAND IDENTIFICATION -->
                <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="1. STORE IDENTITY &amp; BRAND BANNER" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>

                            <!-- Store Number -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Store Number *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="StoreNumberBox" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" ToolTip="e.g. 1045"/>
                            </StackPanel>

                            <!-- Brand Banner -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Brand Banner *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <ComboBox x:Name="BannerCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Charlotte Russe (CR)" Tag="CR"/>
                                    <ComboBoxItem Content="Urban Planet (UP)" Tag="UP"/>
                                    <ComboBoxItem Content="Bluenotes (BN)" Tag="BN"/>
                                    <ComboBoxItem Content="Suzy Shier (SS)" Tag="SS"/>
                                    <ComboBoxItem Content="Sirens (SRN)" Tag="SRN"/>
                                    <ComboBoxItem Content="Rue21 (R21)" Tag="R21"/>
                                    <ComboBoxItem Content="Mandee (M)" Tag="M"/>
                                    <ComboBoxItem Content="West 49 (W49)" Tag="W49"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Project Type -->
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Project Type *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <ComboBox x:Name="ProjectTypeCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="New Store Opening"/>
                                    <ComboBoxItem Content="Active Fleet"/>
                                    <ComboBoxItem Content="Major Remodel"/>
                                    <ComboBoxItem Content="Minor Refresh"/>
                                    <ComboBoxItem Content="Brand Conversion"/>
                                    <ComboBoxItem Content="Relocation"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Store Name -->
                        <StackPanel Margin="0,0,0,2">
                            <TextBlock Text="Store Display Name *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <TextBox x:Name="StoreNameBox" ToolTip="e.g. Square One Shopping Centre or Promenade Mall"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- SECTION 2: LOCATION & PROPERTY -->
                <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="2. PROPERTY &amp; GEOGRAPHIC LOCATION" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,10"/>

                        <!-- Mall Name -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mall / Property Name" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="MallNameBox" ToolTip="e.g. Square One Shopping Centre (or Standalone / Street Front)"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Country *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CountryCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Canada (CA)" Tag="CA"/>
                                    <ComboBoxItem Content="United States (US)" Tag="US"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Street Address -->
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Street Address *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                            <TextBox x:Name="AddressBox" ToolTip="e.g. 100 City Centre Dr, Unit #204"/>
                        </StackPanel>

                        <!-- City, State, Postal -->
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="CityBox" ToolTip="e.g. Mississauga"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province / State *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="StateProvinceBox" ToolTip="e.g. ON or TX"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Postal / ZIP Code *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="PostalCodeBox" ToolTip="e.g. L5B 2C9"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 3: DEPLOYMENT STATUS & TIMELINE -->
                <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Padding="14,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="3. DEPLOYMENT STATUS &amp; TARGET DATE" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.3*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Operational Stage *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OperationalStatusCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Planning"/>
                                    <ComboBoxItem Content="Site Survey"/>
                                    <ComboBoxItem Content="GC Construction"/>
                                    <ComboBoxItem Content="Low-Voltage &amp; Power Poles"/>
                                    <ComboBoxItem Content="IT Staging &amp; Telecom"/>
                                    <ComboBoxItem Content="Pre-Opening QA"/>
                                    <ComboBoxItem Content="Grand Open"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Overall Health *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <ComboBox x:Name="OverallHealthCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="On Track"/>
                                    <ComboBoxItem Content="At Risk"/>
                                    <ComboBoxItem Content="Critical Blocker"/>
                                    <ComboBoxItem Content="Complete"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Target Open Date *" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="TargetOpenDateBox" FontFamily="{StaticResource MonoFont}" ToolTip="YYYY-MM-DD (e.g. 2026-11-20)"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SECTION 4: TECHNICAL INFRASTRUCTURE INITIAL SPECS -->
                <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="4. INFRASTRUCTURE &amp; HARDWARE SPECS (DEFAULTS)" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="POS Registers" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="PosCountBox" Text="4" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Power Poles Req." FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPolesBox" Text="2" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Cat6 Data Drops" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingDropsBox" Text="16" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Primary WAN Carrier" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="PrimaryCarrierBox" Text="Bell Canada" ToolTip="e.g. Bell Canada, AT&amp;T, Spectrum Enterprise"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Secondary Failover Carrier" FontSize="11.5" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBox x:Name="SecondaryCarrierBox" Text="Rogers 5G LTE Failover" ToolTip="e.g. Rogers 5G LTE, Verizon 5G"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock x:Name="ValidationStatusText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="#DC2626"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="CancelButton_Click" Width="90" Height="28" Margin="0,0,8,0"/>
                    <Button x:Name="SaveStoreButton" Content="➕ Add Store to Project" Click="SaveStoreButton_Click" Width="170" Height="28"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

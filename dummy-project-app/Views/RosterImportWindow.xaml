<Window x:Class="YMInc.StoreDeploymentApp.Views.RosterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify Dummy Project Dataset — YM Inc. (Standalone)"
        Height="420" Width="530"
        WindowStartupLocation="CenterOwner"
        Background="#FAF9F8"
        Foreground="#201F1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Microsoft App Header -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <TextBlock Text="Standalone Dummy Project Dataset Inspector" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="ImportModeBadge" Background="#FFF4CE" BorderBrush="#D97706" BorderThickness="1" CornerRadius="2" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ImportModeBadgeText" Text="ISOLATED DUMMY DB" FontSize="10" FontWeight="SemiBold" Foreground="#795500"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Rules Callout -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Margin="18,14,18,10" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="ImportSubtitleText" Text="This standalone C# project uses an isolated JSON database (dummy_project_db.json)." FontSize="12" FontWeight="SemiBold" Foreground="#201F1E" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="• Cannot see or connect to the main production project or PostgreSQL." FontSize="11.5" Foreground="#605E5C" Margin="0,0,0,2"/>
                <TextBlock Text="• Corporate Excel spreadsheets are completely isolated and untouched." FontSize="11.5" Foreground="#605E5C"/>
            </StackPanel>
        </Border>

        <!-- File Select Area -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Margin="18,0,18,10" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ActionPromptText" Text="Verify Local Dummy Project Database" FontSize="12.5" FontWeight="SemiBold" Foreground="#201F1E" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedFileText" Text="dummy_project_db.json (8 synthetic stores + 30+ daily tasks)" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#605E5C" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <Button x:Name="BrowseBtn" Content="Verify Dummy Dataset" Click="BrowseButton_Click" Height="30" Width="180"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock x:Name="StatusResultText" Text="Ready to verify..." FontSize="11.5" FontWeight="SemiBold" Foreground="#107C10"
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Width="90" Height="28" Margin="0,0,8,0"/>
                <Button x:Name="SyncButton" Content="Reload Dummy Dataset" Click="SyncButton_Click" Width="160" Height="28"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="YMInc.StoreDeploymentApp.Views.MallRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Landlord Compliance &amp; Requirements Directory — YM Inc."
        Height="840" Width="1400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgCanvasBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Microsoft App Bar -->
            <RowDefinition Height="Auto"/> <!-- Command & KPI Ribbon -->
            <RowDefinition Height="*"/>    <!-- Master-Detail Split -->
            <RowDefinition Height="24"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: MICROSOFT 365 APP BAR -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="14,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YM Inc. Deployment Manager" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                    <TextBlock Text="|" Foreground="#7FBEF2" Margin="0,0,10,0"/>
                    <TextBlock Text="Landlord Compliance &amp; Property Requirements Directory" FontSize="12.5" Foreground="#EBF3FC"/>
                </StackPanel>
                <TextBlock Text="Property Registry (Double-click cells or use form on right to edit)" FontSize="11.5" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ROW 1: COMMAND & KPI RIBBON -->
        <Border Grid.Row="1" Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Manage property outreach status, TTU/cabling mandates, COI thresholds, and loading dock windows. Cells in the table and fields on the right are directly editable."
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#107C10" Margin="0,0,6,0"/>
                            <TextBlock Text="Has Req: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="HasReqsBadgeText" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#D97706" Margin="0,0,6,0"/>
                            <TextBlock Text="No Req (Contacted): " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="ContactedNoReqsBadgeText" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLineBrush}" BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#B91C1C" Margin="0,0,6,0"/>
                            <TextBlock Text="Not Contacted: " FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock x:Name="NotContactedBadgeText" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#EF4444"/>
                        </StackPanel>
                    </Border>

                    <Button Content="💾 Save Selected" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}" MinHeight="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button Content="+ New Property" Click="AddNewMallButton_Click"
                            MinHeight="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button Content="🕒 Change History..." Click="OpenHistoryButton_Click"
                            MinHeight="30" Padding="12,0" Margin="0,0,6,0"/>
                    <Button Content="Close" Click="CloseButton_Click" MinHeight="30" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: MASTER-DETAIL SPLIT -->
        <Grid Grid.Row="2" Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.0*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Directory List & Filter -->
            <Border Grid.Column="0" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="SearchBox_TextChanged"
                                 MinHeight="32" Margin="0,0,8,0" ToolTip="Filter by mall code, property name, landlord, or city..."/>

                        <ComboBox x:Name="RequirementsFilterCombo" Grid.Column="1" Width="195" MinHeight="32" Margin="0,0,8,0" SelectionChanged="RequirementsFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="All Requirement Statuses" Tag="ALL" IsSelected="True"/>
                            <ComboBoxItem Content="Has Requirements" Tag="HAS_REQ"/>
                            <ComboBoxItem Content="No Req. (Contacted)" Tag="NO_REQ_CONTACTED"/>
                            <ComboBoxItem Content="Not Contacted" Tag="NOT_CONTACTED"/>
                            <ComboBoxItem Content="All Contacted Malls" Tag="ALL_CONTACTED"/>
                            <ComboBoxItem Content="All Missing Requirements" Tag="ALL_NO_REQ"/>
                        </ComboBox>

                        <ComboBox x:Name="CountryFilterCombo" Grid.Column="2" Width="125" MinHeight="32" SelectionChanged="CountryFilterCombo_SelectionChanged">
                            <ComboBoxItem Content="All Regions" Tag="ALL" IsSelected="True"/>
                            <ComboBoxItem Content="US — United States" Tag="US"/>
                            <ComboBoxItem Content="CA — Canada" Tag="CA"/>
                        </ComboBox>
                    </Grid>

                    <DataGrid x:Name="MallsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              SelectionChanged="MallsGrid_SelectionChanged" CellEditEnding="MallsGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding MallCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="88" FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PROPERTY NAME" Binding="{Binding PropertyName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="1.5*" MinWidth="135" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="CITY" Binding="{Binding City, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="95"/>
                            <DataGridTextColumn Header="ST" Binding="{Binding StateProvince, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="48" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="OUTREACH" Binding="{Binding ContactedDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="98" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="REQUIREMENTS STATUS" Binding="{Binding RequirementsStatusDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="140" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="COI" Binding="{Binding CoiDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="50" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="AFTER HRS" Binding="{Binding AfterHoursDisplay, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="78" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="CABLING CO" Binding="{Binding CablingVendor, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="92"/>
                            <DataGridTextColumn Header="DELIVERY WINDOW" Binding="{Binding DeliveryWindow, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" Width="135" FontFamily="{StaticResource MonoFont}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="CountSummaryText" Grid.Row="2" Text="Showing Mall Properties"
                               FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- RIGHT PANE: Mall Requirements Form -->
            <Border Grid.Column="2" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="12,8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="FormHeaderTitle" Text="Property Compliance Record" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="FormHeaderSubtitle" Text="Select a property from the table or create a new record." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Mall Code:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="FormMallCodeText" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Country:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="FormCountryCombo" MinHeight="32">
                                    <ComboBoxItem Content="CA — Canada" Tag="CA" IsSelected="True"/>
                                    <ComboBoxItem Content="US — United States" Tag="US"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Property Name:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="FormPropertyNameText" MinHeight="32"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Street Address:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="FormAddressText" MinHeight="32"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Landlord Company:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="FormLandlordText" MinHeight="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Property Type:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="FormPropertyTypeCombo" MinHeight="32">
                                    <ComboBoxItem Content="Enclosed Regional Mall" IsSelected="True"/>
                                    <ComboBoxItem Content="Power Centre / Strip Mall"/>
                                    <ComboBoxItem Content="Outlet Centre"/>
                                    <ComboBoxItem Content="Street Front Flagship"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="FormCityText" MinHeight="32"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Province / State:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                <TextBox x:Name="FormStateProvinceText" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PROPERTY MANAGEMENT CONTACTS" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Contact Name:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormContactNameText" MinHeight="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Operations Phone:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormContactPhoneText" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Email:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormContactEmailText" MinHeight="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Security Dispatch Phone:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormSecurityPhoneText" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource BgSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="2" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="OUTREACH STATUS &amp; DEPLOYMENT PROTOCOLS" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Landlord Contacted:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="FormMallContactedCombo" MinHeight="32">
                                            <ComboBoxItem Content="Yes — Contacted" Tag="True" IsSelected="True"/>
                                            <ComboBoxItem Content="No — Not Contacted" Tag="False"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Assigned Team Member:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormTeamMemberText" MinHeight="32"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="COI Required:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="FormCoiCombo" MinHeight="32">
                                            <ComboBoxItem Content="Yes — Certificate Required" Tag="True" IsSelected="True"/>
                                            <ComboBoxItem Content="No — Exempt" Tag="False"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="After Hours Required:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <ComboBox x:Name="FormAfterHoursCombo" MinHeight="32">
                                            <ComboBoxItem Content="Yes — Night Shift Only" Tag="True"/>
                                            <ComboBoxItem Content="No — Daytime Permitted" Tag="False" IsSelected="True"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Delivery Window:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormDeliveryWindowText" MinHeight="32" FontFamily="{StaticResource MonoFont}" Text="06:00 - 09:30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Min. General Liability ($):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormLiabilityText" MinHeight="32" FontFamily="{StaticResource MonoFont}" Text="5000000"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Assigned Cabling Contractor:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormCablingVendorText" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Lead Field Technician:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FormLeadTechText" MinHeight="32"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Requirements for TTU &amp; Cabling:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="FormSpecialRulesText" MinHeight="68" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="Requirements for Circuits (ISP / Demarc / Rooftop):" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="FormCircuitsRulesText" MinHeight="64" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Intermediate Steps &amp; Outreach Log:" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3"/>
                            <TextBox x:Name="FormIntermediateStepsText" MinHeight="64" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <TextBlock x:Name="FormStatusText" Text="" FontSize="11.5" FontWeight="SemiBold" Foreground="#107C10" Margin="0,0,0,6" HorizontalAlignment="Right"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Save Property Record" Click="SaveButton_Click"
                                    Style="{StaticResource PrimaryButton}" Width="175" MinHeight="34"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ROW 3: MICROSOFT STATUS BAR -->
        <Border Grid.Row="3" Background="#0078D4" Padding="14,0">
            <DockPanel>
                <TextBlock Text="Ready — Landlord Compliance Registry" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="YM Inc. Store Rollout Manager" FontSize="11" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

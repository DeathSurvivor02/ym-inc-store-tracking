<Window x:Class="YMInc.StoreDeploymentApp.Views.RosterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Official Store Roster"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="YM Inc. Roster File Importer" FontSize="16" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Ingest corporate store spreadsheets (.csv or .xlsx) directly into the platform." FontSize="11" Foreground="#94A3B8"/>
        </StackPanel>

        <!-- Convention Callout -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="📌 Store ID Numbering Convention Enforced:" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                <TextBlock Text="• US Located Stores (CR, R21, M): Strictly 6000s range (6001, 6004, 6012)." FontSize="10" Foreground="#E2E8F0"/>
                <TextBlock Text="• Canadian Stores (UP, BN, SS, LC): 4-digit codes starting with 6 (6101, 6142, 6302)." FontSize="10" Foreground="#E2E8F0"/>
            </StackPanel>
        </Border>

        <!-- File Select Area -->
        <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="2" CornerRadius="8" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂 Select Roster Spreadsheet" FontSize="13" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedFileText" Text="Sample: importer/sample_store_roster.csv" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <Button Content="Load Sample CSV &amp; Validate" Click="BrowseButton_Click" Height="34" Width="200" 
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                <TextBlock x:Name="StatusResultText" Text="Ready to parse columns..." FontSize="10" Foreground="#34D399" 
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="CancelButton_Click" Width="90" Height="32" Background="#334155" 
                    Foreground="White" FontWeight="SemiBold" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="SyncButton" Content="Sync to Database" Click="SyncButton_Click" Width="130" Height="32" 
                    Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" IsEnabled="False" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>

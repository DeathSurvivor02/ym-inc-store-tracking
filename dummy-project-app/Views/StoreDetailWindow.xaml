<Window x:Class="YMInc.StoreDeploymentApp.Views.StoreDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Engineering &amp; Deployment Record — YM Inc."
        Height="820" Width="1060"
        MinHeight="720" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="#FAF9F8"
        Foreground="#201F1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Microsoft App Bar -->
            <RowDefinition Height="Auto"/> <!-- Store Identity Ribbon -->
            <RowDefinition Height="*"/>    <!-- Specification Tabs -->
            <RowDefinition Height="Auto"/> <!-- Footer Action Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: MICROSOFT 365 APP BAR -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="14,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="YM Inc. Deployment Manager" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,10,0"/>
                    <TextBlock Text="|" Foreground="#7FBEF2" Margin="0,0,10,0"/>
                    <TextBlock Text="Store Engineering Specification" FontSize="12.5" Foreground="#EBF3FC"/>
                </StackPanel>
                <TextBlock Text="Record Editor" FontSize="11.5" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ROW 1: STORE HEADER RIBBON -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#EFF6FC" BorderBrush="#0F6CBD" BorderThickness="1" CornerRadius="2" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerCodeBadge" Text="CR" Foreground="#0F6CBD" FontFamily="{StaticResource MonoFont}" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock x:Name="StoreNumberText" Text="Store #6142" FontSize="16" FontWeight="SemiBold" Foreground="#201F1E" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Border Background="#F3F2F1" BorderBrush="#D2D0CE" BorderThickness="1" CornerRadius="2" Padding="6,1" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="CountryFlagText" Text="US" FontFamily="{StaticResource MonoFont}" FontSize="10.5" FontWeight="Bold" Foreground="#323130"/>
                        </Border>
                        <TextBlock Text="Health:" FontSize="12" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="HealthCombo" Width="150" MinHeight="32" SelectionChanged="HealthCombo_SelectionChanged">
                            <ComboBoxItem Content="On Track" Tag="On Track"/>
                            <ComboBoxItem Content="At Risk" Tag="At Risk"/>
                            <ComboBoxItem Content="Critical Blocker" Tag="Critical Blocker"/>
                            <ComboBoxItem Content="Complete" Tag="Complete"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Store Name:" FontSize="12" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="StoreNameTextBox" Width="260" MinHeight="32" Margin="0,0,14,0"/>
                        <TextBlock Text="Property:" FontSize="12" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StoreMallText" Text="Yorkdale Shopping Centre" FontSize="12.5" FontWeight="SemiBold" Foreground="#201F1E" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <TextBlock Text="Target Open:" FontSize="12" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TargetDateTextBox" Width="130" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Stage:" FontSize="12" Foreground="#605E5C" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="OperationalStatusCombo" Width="165" MinHeight="32">
                            <ComboBoxItem Content="Grand Open"/>
                            <ComboBoxItem Content="Fixturing"/>
                            <ComboBoxItem Content="Low-Voltage Cabling"/>
                            <ComboBoxItem Content="Site Survey"/>
                            <ComboBoxItem Content="Active Fleet"/>
                            <ComboBoxItem Content="Store Closure"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 2: TECHNICAL SPECIFICATION TABS -->
        <TabControl Grid.Row="2" Margin="14,10,14,0">
            <!-- TAB 1: SITE SURVEY -->
            <TabItem Header="1. Site Survey">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="STRUCTURAL &amp; DEMARCATION SPECIFICATIONS" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ceiling Type:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyCeilingTypeTextBox" MinHeight="34" Margin="0,0,0,12"/>

                                <TextBlock Text="Clear Deck Height (Feet):" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyCeilingHeightTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"/>

                                <TextBlock Text="Survey Status:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SurveyStatusCombo" MinHeight="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Completed &amp; Approved"/>
                                    <ComboBoxItem Content="Submitted (Review Pending)"/>
                                    <ComboBoxItem Content="Scheduled"/>
                                    <ComboBoxItem Content="In Progress"/>
                                    <ComboBoxItem Content="Pending Field Survey"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Demarc Location:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyDemarcLocationTextBox" MinHeight="34" Margin="0,0,0,12"/>

                                <TextBlock Text="Demarc Conduit Status:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <ComboBox x:Name="SurveyConduitCombo" MinHeight="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Clear &amp; Available (Ready)" Tag="True"/>
                                    <ComboBoxItem Content="Blocked / Missing (Requires Riser Work)" Tag="False"/>
                                    <ComboBoxItem Content="Demarc in Backroom (Direct)" Tag="True"/>
                                </ComboBox>

                                <TextBlock Text="Surveyor / Field Dispatch:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyorTextBox" MinHeight="34" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#FAF9F8" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="14">
                            <StackPanel>
                                <TextBlock Text="FIELD OBSERVATIONS &amp; INFRASTRUCTURE NOTES" FontSize="11" FontWeight="Bold" Foreground="#323130" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Network Rack Location:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SurveyRackLocationTextBox" MinHeight="34"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Survey Submission Date:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="SurveyDateTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Facility Observations (Drop Pole, Audio, Ladder, Washrooms):" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="SurveyNotesTextBox" MinHeight="72" VerticalContentAlignment="Top" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: POWER POLES -->
            <TabItem Header="2. Power Poles">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="WIREMOLD 25DTP-4 CASH WRAP DUAL-CHANNEL FEEDS" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Installation Status:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PowerPoleStatusCombo" MinHeight="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Existing Pole Verified Present"/>
                                    <ComboBoxItem Content="New Drop Pole Installation Required"/>
                                    <ComboBoxItem Content="Fully Installed &amp; Certified"/>
                                    <ComboBoxItem Content="Delivered On Site"/>
                                    <ComboBoxItem Content="In Progress"/>
                                    <ComboBoxItem Content="Survey Required"/>
                                    <ComboBoxItem Content="Pending Site Survey Verification"/>
                                    <ComboBoxItem Content="Blocked / On Hold"/>
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Poles Installed:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PowerPoleInstalledTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Total Required:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="PowerPoleTotalTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Finish Color:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleColorTextBox" MinHeight="34" Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ceiling Mount Type:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleMountTextBox" MinHeight="34" Margin="0,0,0,12"/>

                                <TextBlock Text="Cash Wrap Drops:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleDropsTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"/>

                                <TextBlock Text="Electrical Contractor:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="PowerPoleContractorTextBox" MinHeight="34" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Text="Blocker / Exception Notes:" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" Margin="0,0,0,4"/>
                            <TextBox x:Name="PowerPoleBlockerTextBox" MinHeight="68" VerticalContentAlignment="Top" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: CABLING -->
            <TabItem Header="3. Structured Cabling">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="CAT6 PLENUM STRUCTURED CABLING MATRIX" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cabling Status:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CablingStatusCombo" MinHeight="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Fluke Certified &amp; Closed"/>
                                    <ComboBoxItem Content="Pathway &amp; J-Hooks Installed"/>
                                    <ComboBoxItem Content="Rough-In In Progress"/>
                                    <ComboBoxItem Content="Vendor Assigned"/>
                                    <ComboBoxItem Content="Blocked"/>
                                </ComboBox>

                                <TextBlock Text="Total Data Drops:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingTotalDropsTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="POS Drops:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CablingPosDropsTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="AP Wireless Drops:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CablingApDropsTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fluke Test Certification:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CablingFlukeCombo" MinHeight="34" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Certified &amp; Passed" Tag="True"/>
                                    <ComboBoxItem Content="Pending Certification" Tag="False"/>
                                </ComboBox>

                                <TextBlock Text="Assigned Cabling Contractor:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingVendorTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,12"/>

                                <TextBlock Text="Lead Field Technician:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                <TextBox x:Name="CablingTechTextBox" MinHeight="34" Margin="0,0,0,12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: TELECOM WAN -->
            <TabItem Header="4. WAN Circuits">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <TextBlock Text="DUAL-WAN CARRIER CIRCUIT INVENTORY (DIRECTLY EDITABLE)" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CircuitsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAF9F8" BorderBrush="#D2D0CE" BorderThickness="1" CornerRadius="2" Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="150"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="160"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,4"/>
                                                <TextBlock Text="Carrier:" FontSize="11" Foreground="#605E5C" Margin="0,0,0,2"/>
                                                <TextBox Text="{Binding CarrierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Service Type &amp; Notes:" FontSize="11" Foreground="#605E5C" Margin="0,18,0,2"/>
                                                <TextBox Text="{Binding ServiceType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Down / Up (Mbps):" FontSize="11" Foreground="#605E5C" Margin="0,18,0,2"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Text="{Binding BandwidthDownMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                                                    <TextBox Grid.Column="2" Text="{Binding BandwidthUpMbps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontFamily="{StaticResource MonoFont}"/>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Grid.Column="6">
                                                <TextBlock Text="Order Status:" FontSize="11" Foreground="#605E5C" Margin="0,18,0,2"/>
                                                <TextBox Text="{Binding OrderStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: MALL RULES -->
            <TabItem Header="5. Landlord Compliance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                            <TextBlock x:Name="MallNameHeading" Text="LANDLORD COMPLIANCE &amp; DELIVERY REQUIREMENTS" FontSize="11.5" FontWeight="Bold" Foreground="#0F6CBD" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Border x:Name="MallReqStatusBadgeBorder" Background="#F3F2F1" BorderBrush="#D2D0CE" BorderThickness="1" CornerRadius="2" Padding="8,2">
                                <TextBlock x:Name="MallReqStatusBadgeText" Text="Has Req." FontSize="10.5" FontWeight="SemiBold" Foreground="#323130"/>
                            </Border>
                        </StackPanel>

                        <Border Background="#FAF9F8" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Landlord Contacted:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MallContactedCombo" MinHeight="34" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Yes — Contacted" Tag="True"/>
                                        <ComboBoxItem Content="No — Not Contacted" Tag="False"/>
                                    </ComboBox>

                                    <TextBlock Text="Certificate of Insurance (COI):" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MallCoiCombo" MinHeight="34" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Mandatory (COI Required)" Tag="True"/>
                                        <ComboBoxItem Content="Not Required / Exempt" Tag="False"/>
                                    </ComboBox>

                                    <TextBlock Text="After Hours Work Mandate:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="MallAfterHoursCombo" MinHeight="34" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Mandatory Night Shift Only" Tag="True"/>
                                        <ComboBoxItem Content="Daytime Work Permitted" Tag="False"/>
                                    </ComboBox>

                                    <TextBlock Text="Delivery Window:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MallDeliveryTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Text="06:00 - 09:30"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Landlord Management Company:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MallLandlordCompanyTextBox" MinHeight="34" Margin="0,0,0,10"/>

                                    <TextBlock Text="Assigned Outreach Member:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MallTeamMemberTextBox" MinHeight="34" Margin="0,0,0,10"/>

                                    <TextBlock Text="Minimum General Liability ($):" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MallLiabilityTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}" Margin="0,0,0,10" Text="5000000"/>

                                    <TextBlock Text="Assigned Cabling Contractor:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                    <TextBox x:Name="MallCablingCompanyTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#FAF9F8" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="PROPERTY MANAGEMENT CONTACTS" FontSize="11" FontWeight="Bold" Foreground="#323130" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Operations Contact Name:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MallContactNameTextBox" MinHeight="34" Margin="0,0,0,10"/>

                                        <TextBlock Text="Operations Phone:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MallContactPhoneTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Operations Email:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MallContactEmailTextBox" MinHeight="34" Margin="0,0,0,10"/>

                                        <TextBlock Text="Security Dispatch Phone:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                                        <TextBox x:Name="MallSecurityPhoneTextBox" MinHeight="34" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Requirements for TTU &amp; Cabling:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                            <TextBox x:Name="MallSpecialRulesTextBox" MinHeight="64" VerticalContentAlignment="Top" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Intermediate Steps &amp; Outreach Log:" FontSize="12" Foreground="#323130" Margin="0,0,0,4"/>
                            <TextBox x:Name="MallIntermediateStepsTextBox" MinHeight="60" VerticalContentAlignment="Top" Padding="8,6" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <Button Content="Open Full Landlord Directory..." Click="OpenMallDirectoryButton_Click"
                                Width="220" MinHeight="32" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 6: STORE CHANGE HISTORY -->
            <TabItem Header="6. Change History">
                <Grid Margin="14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="CHRONOLOGICAL STORE &amp; PROPERTY AUDIT TRAIL" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD" VerticalAlignment="Center"/>
                        <Button Content="🕒 Open Global History Window..." Click="ViewHistoryButton_Click" MinHeight="28" Padding="10,0" HorizontalAlignment="Right"/>
                    </DockPanel>

                    <DataGrid x:Name="StoreHistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TIMESTAMP" Binding="{Binding TimestampDisplay}" Width="140" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="OPERATOR" Binding="{Binding OperatorDisplay}" Width="130" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="135" FontFamily="{StaticResource MonoFont}"/>
                            <DataGridTextColumn Header="FIELD / ACTION" Binding="{Binding FieldName}" Width="165" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="PREVIOUS VALUE" Binding="{Binding PreviousValue}" Width="135"/>
                            <DataGridTextColumn Header="NEW VALUE" Binding="{Binding NewValue}" Width="135" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ROW 3: FOOTER ACTION BAR -->
        <Border Grid.Row="3" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="18,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SaveNotificationText" Grid.Column="0" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#107C10" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="💾 Save Store &amp; Property Changes" Click="SaveButton_Click"
                            Style="{StaticResource PrimaryButton}" Padding="14,0" MinHeight="32" Margin="0,0,8,0"/>
                    <Button Content="🕒 Change History..." Click="ViewHistoryButton_Click"
                            Padding="12,0" MinHeight="32" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                            Width="90" MinHeight="32"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="YMInc.StoreDeploymentApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:YMInc.StoreDeploymentApp.Controls"
        Title="YM Inc. Store Deployment &amp; Infrastructure Platform"
        Height="800" Width="1240"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F17"
        Foreground="#F8FAFC">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar -->
            <RowDefinition Height="Auto"/> <!-- Donut Section -->
            <RowDefinition Height="*"/>    <!-- Data Grid Section -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- TOP APPLICATION BAR -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand & System Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" Background="#2563EB" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="YM" Foreground="White" FontSize="18" FontWeight="Black" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="YM Inc. Store Deployment Hub" FontSize="15" FontWeight="Bold" Foreground="White"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Track A Technical Operations" FontSize="9" FontWeight="Bold" Foreground="#93C5FD"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Capital Lifecycle, Power Poles, Cat6 Cabling &amp; Dual-WAN Turn-up" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>

                <!-- Active User Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="20" Padding="12,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤 Logged in as: " FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock x:Name="CurrentUserNameText" Text="Marcus Vance" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,6,0"/>
                            <Border Background="#0F172A" CornerRadius="4" Padding="6,1">
                                <TextBlock x:Name="CurrentUserRoleBadge" Text="IT Director (Full Admin)" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MallRulesButton" Content="🏢 Mall Landlord Rules" Click="MallRulesButton_Click" 
                            Height="32" Padding="12,0" Background="#1E293B" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" 
                            BorderBrush="#334155" Margin="0,0,8,0" Cursor="Hand"/>
                    
                    <Button x:Name="ImportRosterButton" Content="📥 Import Roster" Click="ImportRosterButton_Click" 
                            Height="32" Padding="12,0" Background="#2563EB" Foreground="White" FontSize="11" FontWeight="Bold" 
                            BorderThickness="0" Margin="0,0,8,0" Cursor="Hand"/>

                    <Button Content="Sign Out" Click="SignOutButton_Click" 
                            Height="32" Padding="10,0" Background="#334155" Foreground="#E2E8F0" FontSize="11" FontWeight="SemiBold" 
                            BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- HERO SECTION: WEEKLY INSTALLATION PROGRESS DONUT -->
        <Border Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/> <!-- Donut -->
                    <ColumnDefinition Width="220"/> <!-- Slices list -->
                    <ColumnDefinition Width="*"/>   <!-- Milestones -->
                </Grid.ColumnDefinitions>

                <!-- Donut Column -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock Text="Weekly Progress Donut" FontSize="13" FontWeight="Bold" Foreground="White"/>
                        <Border Background="#064E3B" CornerRadius="4" Padding="4,1" Margin="6,0,0,0">
                            <TextBlock Text="+12% velocity" FontSize="9" FontWeight="Bold" Foreground="#34D399"/>
                        </Border>
                    </StackPanel>

                    <!-- Interactive Donut Custom Control -->
                    <controls:DonutChartControl x:Name="DonutChart" Width="180" Height="180" HorizontalAlignment="Center"/>

                    <!-- Week Selector -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="Wk41Button" Content="Fiscal Wk 41" Click="Wk41Button_Click" 
                                Width="84" Height="24" FontSize="10" FontWeight="Bold" Background="#2563EB" Foreground="White" BorderThickness="0" Margin="0,0,4,0" Cursor="Hand"/>
                        <Button x:Name="Wk42Button" Content="Fiscal Wk 42" Click="Wk42Button_Click" 
                                Width="84" Height="24" FontSize="10" FontWeight="Bold" Background="#1E293B" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>

                <!-- Slices Category Breakdown -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,16,0">
                    <TextBlock Text="Installation Breakdown:" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,6"/>
                    
                    <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0"/>
                                <TextBlock Text="Completed &amp; Certified" FontSize="11" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <TextBlock x:Name="CompletedCountText" Text="13 (54%)" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#0EA5E9" Margin="0,0,6,0"/>
                                <TextBlock Text="In Progress / On Track" FontSize="11" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <TextBlock x:Name="InProgressCountText" Text="7 (29%)" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,6,0"/>
                                <TextBlock Text="Scheduled / Pending" FontSize="11" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <TextBlock x:Name="PendingCountText" Text="3 (13%)" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="6" Padding="8,6">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#F43F5E" Margin="0,0,6,0"/>
                                <TextBlock Text="Blocked / In Jeopardy" FontSize="11" Foreground="#E2E8F0"/>
                            </StackPanel>
                            <TextBlock x:Name="BlockedCountText" Text="1 (4%)" FontSize="11" FontWeight="Bold" Foreground="#F87171" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="FilterActiveNotice" Text="* Table filtered by slice" FontSize="9" Foreground="#38BDF8" 
                               Margin="0,4,0,0" Visibility="Collapsed" HorizontalAlignment="Right"/>
                </StackPanel>

                <!-- Milestone Progress Bars -->
                <Border Grid.Column="2" Background="#111827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Physical Installation Milestones Burn-up" FontSize="12" FontWeight="Bold" Foreground="White" Margin="0,0,0,8"/>

                        <!-- Milestone 1 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Site Surveys Approved" FontSize="11" Foreground="#CBD5E1"/>
                            <TextBlock Text="23 / 24 (96%)" FontSize="10" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="96" Height="6" Background="#1F2937" Foreground="#10B981" BorderThickness="0" Margin="0,0,0,8"/>

                        <!-- Milestone 2 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Wiremold 25DTP-4 Power Poles Installed" FontSize="11" Foreground="#CBD5E1"/>
                            <TextBlock Text="18 / 24 (75%)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="75" Height="6" Background="#1F2937" Foreground="#0EA5E9" BorderThickness="0" Margin="0,0,0,8"/>

                        <!-- Milestone 3 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Cat6 Plenum Cabling Certified (Fluke)" FontSize="11" Foreground="#CBD5E1"/>
                            <TextBlock Text="16 / 24 (67%)" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="67" Height="6" Background="#1F2937" Foreground="#0EA5E9" BorderThickness="0" Margin="0,0,0,8"/>

                        <!-- Milestone 4 -->
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Dual-WAN Circuits Turned Up (Fiber DIA + LTE)" FontSize="11" Foreground="#CBD5E1"/>
                            <TextBlock Text="14 / 24 (58%)" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="58" Height="6" Background="#1F2937" Foreground="#F59E0B" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- DATA GRID SECTION: STORE DEPLOYMENT ROSTER -->
        <Grid Grid.Row="2" Margin="16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Filters & Search -->
                <RowDefinition Height="*"/>    <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- Filter Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Country Dropdown -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Country:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CountryFilterCombo" SelectionChanged="CountryFilterCombo_SelectionChanged" 
                              Height="28" Width="90" Background="#0F172A" Foreground="#0F172A" BorderBrush="#334155" FontSize="11">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="CA" Tag="CA"/>
                        <ComboBoxItem Content="US" Tag="US"/>
                    </ComboBox>
                </StackPanel>


                <!-- Banner Dropdown -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Banner:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="BannerFilterCombo" SelectionChanged="BannerFilterCombo_SelectionChanged" 
                              Height="28" Width="140" Background="#0F172A" Foreground="#0F172A" BorderBrush="#334155" FontSize="11">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Banners" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="Bluenotes (BN)" Tag="BN"/>
                        <ComboBoxItem Content="Charlotte Russe (CR)" Tag="CR"/>
                        <ComboBoxItem Content="Urban Planet (UP)" Tag="UP"/>
                        <ComboBoxItem Content="rue21 (R21)" Tag="R21"/>
                        <ComboBoxItem Content="Mandee (M)" Tag="M"/>
                    </ComboBox>

                </StackPanel>

                <!-- Filter By Dropdown -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="Filter By:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SearchFieldCombo" SelectionChanged="SearchFieldCombo_SelectionChanged" 
                              Height="28" Width="110" Background="#0F172A" Foreground="#0F172A" BorderBrush="#334155" FontSize="11">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="All Fields" IsSelected="True" Tag="ALL"/>
                        <ComboBoxItem Content="Mall Name" Tag="MALL"/>
                        <ComboBoxItem Content="Address" Tag="ADDRESS"/>
                        <ComboBoxItem Content="City / State" Tag="CITY"/>
                        <ComboBoxItem Content="Store #" Tag="STORE_NO"/>
                        <ComboBoxItem Content="Phone / Contact" Tag="PHONE"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search Input -->
                <TextBox x:Name="SearchBox" Grid.Column="3" TextChanged="SearchBox_TextChanged"
                         Height="28" Background="#0F172A" Foreground="White" BorderBrush="#334155" 
                         Padding="8,4" FontSize="11" VerticalContentAlignment="Center"
                         ToolTip="Type to filter by Store #, Mall Name, Street Address, City, State, Phone, Contact, Banner, or Stage..."/>

                <Button Grid.Column="4" Content="🔍 Inspect Specs" Click="InspectSelectedButton_Click" 
                        Height="28" Padding="14,0" Background="#334155" Foreground="White" FontSize="11" FontWeight="Bold" 
                        BorderThickness="0" Margin="8,0,0,0" Cursor="Hand"/>
            </Grid>

            <!-- Store DataGrid -->
            <DataGrid x:Name="StoresDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="#0F172A" RowBackground="#0F172A" AlternatingRowBackground="#1E293B"
                      BorderBrush="#1E293B" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E293B"
                      Foreground="#E2E8F0" FontSize="11" SelectionMode="Single"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      MouseDoubleClick="StoresDataGrid_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E293B"/>
                        <Setter Property="Foreground" Value="#94A3B8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#334155"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Store #" Binding="{Binding StoreNumber}" Width="75"/>
                    <DataGridTextColumn Header="Banner" Binding="{Binding BannerCode}" Width="65"/>
                    <DataGridTextColumn Header="Mall Name" Binding="{Binding MallName}" Width="175"/>
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="210"/>
                    <DataGridTextColumn Header="City / State" Binding="{Binding CityState}" Width="120"/>
                    <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="110"/>
                    <DataGridTextColumn Header="Store Name" Binding="{Binding StoreName}" Width="180"/>
                    <DataGridTextColumn Header="Country" Binding="{Binding CountryFlag}" Width="65"/>
                    <DataGridTextColumn Header="Stage" Binding="{Binding OperationalStatus}" Width="85"/>
                    <DataGridTextColumn Header="Health" Binding="{Binding OverallHealth}" Width="85"/>
                    <DataGridTextColumn Header="Wiremold Power Poles" Binding="{Binding PowerPoleSummary}" Width="140"/>
                    <DataGridTextColumn Header="Cat6 Cabling Drops" Binding="{Binding CablingSummary}" Width="140"/>
                    <DataGridTextColumn Header="Dual-WAN Circuits" Binding="{Binding CircuitSummary}" Width="120"/>
                    <DataGridTextColumn Header="Target Open" Binding="{Binding TargetOpenDate}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- STATUS BAR & DATABASE LINK -->
        <Border Grid.Row="3" Background="#090D14" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="DbStatusText" Text="● PostgreSQL 16 Online (localhost:5432/ym_store_tracking)" FontSize="11" Foreground="#10B981"/>
                    <Button Content="Reconnect" Click="ReconnectButton_Click" Height="20" Padding="6,0" 
                            Background="#1E293B" Foreground="#94A3B8" FontSize="9" BorderBrush="#334155" Margin="8,0,0,0" Cursor="Hand"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="YM Inc. IT Store Deployment Platform — .NET 10 Desktop Client" 
                           FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>

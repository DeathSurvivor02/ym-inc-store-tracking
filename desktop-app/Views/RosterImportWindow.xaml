<Window x:Class="YMInc.StoreDeploymentApp.Views.RosterImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Store Roster — YM Inc."
        Height="420" Width="530"
        WindowStartupLocation="CenterOwner"
        Background="#FAF9F8"
        Foreground="#201F1E">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Microsoft App Header -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <TextBlock Text="Store Roster &amp; Dataset Importer" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Border x:Name="ImportModeBadge" Background="#0C5596" BorderBrush="#62ABF5" BorderThickness="1" CornerRadius="2" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="ImportModeBadgeText" Text="PRODUCTION DB" FontSize="10" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Rules Callout -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Margin="18,14,18,10" Padding="14,10">
            <StackPanel>
                <TextBlock x:Name="ImportSubtitleText" Text="Ingest corporate store spreadsheets (.csv or .xlsx) into PostgreSQL." FontSize="12" FontWeight="SemiBold" Foreground="#201F1E" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <TextBlock Text="• Validates storefront records against the YM Inc. 3NF PostgreSQL schema." FontSize="11.5" Foreground="#605E5C" Margin="0,0,0,2"/>
                <TextBlock Text="• Updates store contacts, opening dates, and landlord requirement links." FontSize="11.5" Foreground="#605E5C"/>
            </StackPanel>
        </Border>

        <!-- File Select Area -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" Margin="18,0,18,10" Padding="20">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="ActionPromptText" Text="Select Roster Spreadsheet or Dataset" FontSize="12.5" FontWeight="SemiBold" Foreground="#201F1E" HorizontalAlignment="Center"/>
                <TextBlock x:Name="SelectedFileText" Text="importer/sample_store_roster.csv" FontFamily="{StaticResource MonoFont}" FontSize="11.5" Foreground="#605E5C" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                <Button x:Name="BrowseBtn" Content="Validate Dataset" Click="BrowseButton_Click" Height="30" Width="180"
                        Style="{StaticResource PrimaryButton}"/>
                <TextBlock x:Name="StatusResultText" Text="Ready to parse columns..." FontSize="11.5" FontWeight="SemiBold" Foreground="#107C10"
                           HorizontalAlignment="Center" Margin="0,10,0,0" Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="18,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelButton_Click" Width="90" Height="28" Margin="0,0,8,0"/>
                <Button x:Name="SyncButton" Content="Commit to Database" Click="SyncButton_Click" Width="150" Height="28"
                        Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

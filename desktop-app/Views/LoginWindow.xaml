<Window x:Class="YMInc.StoreDeploymentApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YM Inc. Store Deployment Platform — Internal Team Sign-in"
        Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    
    <Border BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Margin="12" Background="#0F172A">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Logo -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Border Width="56" Height="56" CornerRadius="12" Background="#2563EB" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="YM" Foreground="White" FontSize="26" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="YM Inc. Deployment Hub" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                <TextBlock Text="Internal Team Portal: PM • PA • 4 PS" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Quick Internal Team Sign-in Selection -->
            <Border Grid.Row="1" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Select Internal Team Profile:" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,6"/>
                    <ComboBox x:Name="DemoProfileCombo" SelectionChanged="DemoProfileCombo_SelectionChanged" 
                              Background="#0F172A" Foreground="#0F172A" BorderBrush="#334155" FontSize="11" Padding="6,4">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#0F172A"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2563EB"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E3A8A"/>
                                        <Setter Property="Foreground" Value="#93C5FD"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBoxItem Content="PM — Project Manager (Marcus Vance)" IsSelected="True" Tag="pm:pm123"/>
                        <ComboBoxItem Content="PA — Project Administrator (Claire Tremblay)" Tag="pa:pa123"/>
                        <ComboBoxItem Content="PS 1 — Project Specialist 1 (Terry O'Connor)" Tag="ps1:ps123"/>
                        <ComboBoxItem Content="PS 2 — Project Specialist 2 (Danielle Levy)" Tag="ps2:ps2123"/>
                        <ComboBoxItem Content="PS 3 — Project Specialist 3 (Hector Ruiz)" Tag="ps3:ps3123"/>
                        <ComboBoxItem Content="PS 4 — Project Specialist 4 (Sarah Jenkins)" Tag="ps4:ps4123"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Credentials Form -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <TextBlock Text="Team User ID (e.g. pm, pa, ps1, ps2, ps3, ps4)" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                <TextBox x:Name="UsernameBox" Text="pm" Height="36" Background="#0B0F17" Foreground="White" 
                         BorderBrush="#334155" Padding="8,6" FontSize="12" Margin="0,0,0,14"/>

                <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#CBD5E1" Margin="0,0,0,4"/>
                <PasswordBox x:Name="PasswordBox" Password="pm123" Height="36" Background="#0B0F17" Foreground="White" 
                             BorderBrush="#334155" Padding="8,6" FontSize="12" Margin="0,0,0,16"/>

                <TextBlock x:Name="ErrorTextBlock" Foreground="#F43F5E" FontSize="11" TextWrapping="Wrap" 
                           Visibility="Collapsed" Margin="0,0,0,10"/>

                <Button x:Name="LoginButton" Content="Sign In to Platform" Click="LoginButton_Click" 
                        Height="40" Background="#2563EB" Foreground="White" FontWeight="Bold" FontSize="12" 
                        BorderThickness="0" Cursor="Hand"/>
            </StackPanel>

            <!-- Database & Security Status Footer -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Center">
                <TextBlock Text="● Direct PostgreSQL 16 Data Warehouse Sync" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center"/>
                <TextBlock Text="Internal Team Access: PM • PA • 4 PS" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,0"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>

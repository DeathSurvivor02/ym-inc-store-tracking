<Window x:Class="YMInc.StoreDeploymentApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YM Inc. Dummy Project Sandbox (Standalone C# Application) — Sign In"
        Height="580" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="#FAF9F8"
        Foreground="#201F1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: MICROSOFT FLUENT APPLICATION BAR -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" Background="#FFFFFF" CornerRadius="2" Margin="0,0,10,0">
                        <TextBlock Text="YM" FontSize="9.5" FontWeight="Bold" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YM Inc. Store Rollout Manager — Standalone Dummy Project Sandbox" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton" Content="🌙 Dark Theme" Click="ThemeToggleButton_Click"
                            Height="24" Padding="9,0" FontSize="11" Margin="0,0,10,0"
                            ToolTip="Switch between Microsoft Light and Dark Theme"/>
                    <Border Background="#FFF4CE" BorderBrush="#D97706" BorderThickness="1" CornerRadius="2" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="ISOLATED DUMMY DB PROJECT" FontSize="10" FontWeight="Bold" Foreground="#795500"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: SYSTEM OVERVIEW -->
            <Border Grid.Column="0" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,0,1,0" Padding="24,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="STANDALONE DUMMY C# PROJECT" FontSize="10.5" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,6"/>
                        <TextBlock Text="Isolated Test &amp; Training Deployment Environment" FontSize="18" FontWeight="SemiBold" Foreground="#201F1E" TextWrapping="Wrap" LineHeight="24"/>
                        <TextBlock Text="This is a standalone C# WPF project with zero connection or reference to the main production project or corporate Excel spreadsheets."
                                   FontSize="12" Foreground="#605E5C" TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Background="#E1DFDD" Margin="0,18"/>

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="INCLUDED DUMMY DATASET" FontSize="10.5" FontWeight="Bold" Foreground="#605E5C" Margin="0,0,0,10"/>

                        <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="1. 8 Synthetic Stores (#9101–#9108)" FontSize="12" FontWeight="SemiBold" Foreground="#201F1E"/>
                                <TextBlock Text="Test surveys, power poles, Cat6 drops, and WAN circuits" FontSize="11" Foreground="#605E5C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="10,8" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="2. Multi-Week Calendar (Weeks 36–43)" FontSize="12" FontWeight="SemiBold" Foreground="#201F1E"/>
                                <TextBlock Text="30+ daily TTU, circuit install, and cabling test tasks" FontSize="11" Foreground="#605E5C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="2" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="3. 6 Synthetic Mall Properties" FontSize="12" FontWeight="SemiBold" Foreground="#201F1E"/>
                                <TextBlock Text="Editable landlord rules and compliance contacts" FontSize="11" Foreground="#605E5C" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="3" Background="#FFF4CE" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="2" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Isolated Local Database (dummy_project_db.json)" FontSize="11" FontWeight="SemiBold" Foreground="#795500"/>
                            <TextBlock Text="Cannot see or modify the main production project or Excel workbooks." FontSize="10.5" Foreground="#323130" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANE: MICROSOFT SIGN-IN CARD -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center" Width="380" HorizontalAlignment="Center">
                    <TextBlock Text="Sign in (Dummy Project)" FontSize="22" FontWeight="SemiBold" Foreground="#201F1E"/>
                    <TextBlock Text="Sign in with any role preset below to test stores, landlord rules, and daily calendar tasks."
                               FontSize="12" Foreground="#605E5C" Margin="0,4,0,20" TextWrapping="Wrap"/>

                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Text="pm" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Password -->
                    <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="PasswordBox" Password="pm123" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Error Banner -->
                    <Border x:Name="ErrorBanner" Background="#FDE7E9" BorderBrush="#F1707B" BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Text="Invalid username or password." Foreground="#A4262C" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Primary Action Button -->
                    <Button x:Name="LaunchButton" Content="Sign In to Standalone Dummy Project" Click="SignInButton_Click"
                            IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Height="34" FontSize="13"/>

                    <!-- Quick Role Switcher -->
                    <Border BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK ROLE PRESETS" FontSize="10.5" FontWeight="Bold" Foreground="#605E5C" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="PM (Admin)" Click="QuickLoginPM_Click" Height="28" FontSize="11.5"/>
                                <Button Grid.Column="2" Content="PA (Analyst)" Click="QuickLoginPA_Click" Height="28" FontSize="11.5"/>
                                <Button Grid.Column="4" Content="PS1 (Field Tech)" Click="QuickLoginTech_Click" Height="28" FontSize="11.5"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ROW 2: MICROSOFT STATUS BAR -->
        <Border Grid.Row="2" Background="#0078D4" Padding="16,0">
            <DockPanel>
                <TextBlock Text="Ready — Standalone Dummy Project (dummy_project_db.json — Main Project Isolated)" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="NRF 4-5-4 Fiscal Calendar Enabled" FontSize="11" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

<Window x:Class="YMInc.StoreDeploymentApp.Views.StoreDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Store Technical Deployment Specification"
        Height="680" Width="820"
        WindowStartupLocation="CenterOwner"
        Background="#0B0F17"
        Foreground="#F8FAFC">
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Store Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="52" Height="52" Background="#1E3A8A" CornerRadius="8" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BannerCodeBadge" Text="BN" Foreground="#93C5FD" FontSize="18" FontWeight="Black" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StoreNumberText" Text="Store #6142" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,8,0"/>
                        <Border x:Name="HealthBadge" Background="#064E3B" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock x:Name="HealthText" Text="On Track" Foreground="#34D399" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StoreNameText" Text="Bluenotes Yorkdale Flagship" FontSize="13" FontWeight="SemiBold" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                    <TextBlock x:Name="StoreLocationText" Text="3401 Dufferin St, Toronto, ON M6A 2T9" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Target Open Date:" FontSize="10" Foreground="#64748B"/>
                    <TextBlock x:Name="TargetDateText" Text="2026-11-27" FontSize="14" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="StageText" Text="Low-Voltage &amp; Power Poles" FontSize="10" Foreground="#CBD5E1" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Technical Specification Tabs -->
        <TabControl Grid.Row="1" Background="#0F172A" BorderBrush="#1E293B">
            <!-- TAB 1: SITE SURVEY -->
            <TabItem Header="📋 Site Survey Specs" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Structural &amp; Ceiling Specifications" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Ceiling Type:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyCeilingTypeText" Text="Drop Ceiling (2x4 Tiles)" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Clear Deck Height:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyCeilingHeightText" Text="14.5 ft" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Survey Status:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyStatusText" Text="Completed &amp; Approved" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Demarc Location:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyDemarcLocationText" Text="Mall Common Telco Rm B1-14" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Demarc Conduit Status:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyConduitText" Text="Clear &amp; Available" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>

                                <TextBlock Text="Surveyor &amp; Vendor:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="SurveyorText" Text="Dave Miller (CompuCom)" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: POWER POLES -->
            <TabItem Header="⚡ Wiremold Power Poles" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Wiremold 25DTP-4 Dual-Channel Feeds" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Installation Status:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleStatusText" Text="Delivered On Site" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,10"/>

                                <TextBlock Text="Poles Installed vs Required:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleCountText" Text="0 of 2 Installed" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Finish Color:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleColorText" Text="Matte Black" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Ceiling Mount Type:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleMountText" Text="T-Bar Grid Clamp with Structural Tie-Wire" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Cash Wrap Drops:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleDropsText" Text="4 Feed Drops" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Electrical Contractor:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="PowerPoleContractorText" Text="Guild Electric Ltd." FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PowerPoleBlockerBorder" Background="#450A0A" BorderBrush="#991B1B" BorderThickness="1" CornerRadius="6" Padding="12" Visibility="Collapsed">
                            <TextBlock x:Name="PowerPoleBlockerText" Text="⚠️ Blocker Reason" Foreground="#FCA5A5" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: CABLING -->
            <TabItem Header="🔌 Low-Voltage Cabling" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Cat6 Plenum Structured Cabling Matrix" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Cabling Status:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingStatusText" Text="Pathway &amp; J-Hooks Installed" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <TextBlock Text="Total Data Drops:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingTotalDropsText" Text="28 Drops (Cat6 Plenum CMP)" FontSize="13" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="POS &amp; AP Wireless Drops:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingPosApText" Text="6 POS Drops | 4 AP Drops" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Fluke Test Certification:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingFlukeText" Text="Pending Certification" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,10"/>

                                <TextBlock Text="Cabling Contractor:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingVendorText" Text="Black Box Network Services" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Text="Lead Field Technician:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="CablingTechText" Text="Terry O'Connor" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: TELECOM WAN -->
            <TabItem Header="📡 Telecom WAN Circuits" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock Text="Dual-WAN Carrier Circuit Details" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CircuitsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                                <TextBlock Text="{Binding CarrierName}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding ServiceType}" FontSize="11" Foreground="#CBD5E1"/>
                                                <TextBlock FontSize="10" Foreground="#94A3B8">
                                                    <Run Text="Speed: "/><Run Text="{Binding BandwidthDownMbps}" FontWeight="Bold" Foreground="#34D399"/><Run Text=" ↓ / "/><Run Text="{Binding BandwidthUpMbps}" FontWeight="Bold" Foreground="#60A5FA"/><Run Text=" ↑ Mbps"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <Border Background="#0F172A" Padding="6,2" CornerRadius="4">
                                                    <TextBlock Text="{Binding OrderStatus}" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 5: MALL RULES -->
            <TabItem Header="🏢 Mall Landlord Rules" FontSize="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="MallNameHeading" Text="Yorkdale Shopping Centre Rules" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Union Labor Requirement:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MallUnionText" Text="Open Shop Permitted" FontSize="12" FontWeight="Bold" Foreground="#34D399" Margin="0,0,0,10"/>

                                <TextBlock Text="Delivery Window:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MallDeliveryText" Text="06:00 - 09:00" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="Minimum General Liability (COI):" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MallCoiText" Text="$10,000,000 CAD" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,10"/>

                                <TextBlock Text="Security Badging Fee:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock x:Name="MallBadgingText" Text="$25 CAD / technician" FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F172A" Padding="12,8" Margin="0,12,0,0" CornerRadius="6">
            <Button Content="Close Specification" Click="CloseButton_Click" HorizontalAlignment="Right" 
                    Width="140" Height="32" Background="#334155" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
        </Border>
    </Grid>
</Window>

<Window x:Class="YMInc.StoreDeploymentApp.Views.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Corporate Password — YM Inc."
        Height="540" Width="480"
        MinHeight="480" MinWidth="440"
        WindowStartupLocation="CenterOwner"
        Background="#FAF9F8"
        Foreground="#201F1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Microsoft App Header -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" Background="#FFFFFF" CornerRadius="2" Margin="0,0,10,0">
                        <TextBlock Text="YM" FontSize="9.5" FontWeight="Bold" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Reset Corporate Password" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Background="#0C5596" BorderBrush="#62ABF5" BorderThickness="1" CornerRadius="2" Padding="8,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SALT &amp; PEPPER PBKDF2" FontSize="9.5" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <!-- Info Banner -->
                <Border Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="🔒 Enterprise Password Security" FontSize="12.5" FontWeight="SemiBold" Foreground="#0369A1" Margin="0,0,0,3"/>
                        <TextBlock Text="Verify your account identity to assign a new password. All passwords are encrypted with individual 32-byte salts and an enterprise pepper key."
                                   FontSize="11" Foreground="#0284C7" TextWrapping="Wrap" LineHeight="16"/>
                    </StackPanel>
                </Border>

                <!-- Field 1: Username or Email -->
                <TextBlock Text="Username or Corporate Email *" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                <TextBox x:Name="UserIdentifierTextBox" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"
                         ToolTip="Enter your username (e.g. pm) or corporate email address (e.g. mvance@yminc.ca)"/>

                <!-- Field 2: New Password -->
                <TextBlock Text="New Password *" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordBox" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"
                             ToolTip="Minimum 6 characters"/>

                <!-- Field 3: Confirm New Password -->
                <TextBlock Text="Confirm New Password *" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                <!-- Password Policy Info -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SECURITY REQUIREMENTS" FontSize="9.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
                        <TextBlock Text="• Minimum 6 characters in length" FontSize="11" Foreground="#475569"/>
                        <TextBlock Text="• Random 32-byte cryptographic salt generated on commit" FontSize="11" Foreground="#475569"/>
                        <TextBlock Text="• 100,000 PBKDF2 HMAC-SHA256 iterations" FontSize="11" Foreground="#475569"/>
                        <TextBlock Text="• Application-level server pepper verification" FontSize="11" Foreground="#475569"/>
                    </StackPanel>
                </Border>

                <!-- Status / Error Banner -->
                <Border x:Name="StatusBanner" CornerRadius="3" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="StatusText" FontSize="11.5" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click"
                        Width="90" Height="30" HorizontalAlignment="Left"/>
                <Button x:Name="SubmitButton" Content="Reset Password" Click="SubmitButton_Click"
                        IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Width="130" Height="30" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>

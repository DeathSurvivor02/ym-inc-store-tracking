<Window x:Class="YMInc.StoreDeploymentApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YM Inc. Store Rollout &amp; Telecom Manager — Sign In"
        Height="600" Width="900" MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FAF9F8"
        Foreground="#201F1E">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: MICROSOFT FLUENT APPLICATION BAR -->
        <Border Grid.Row="0" Background="#0F6CBD" Padding="16,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="18" Height="18" Background="#FFFFFF" CornerRadius="2" Margin="0,0,10,0">
                        <TextBlock Text="YM" FontSize="9.5" FontWeight="Bold" Foreground="#0F6CBD" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="YM Inc. Store Rollout &amp; Telecom Manager" FontSize="12.5" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="ThemeToggleButton" Content="🌙 Dark Theme" Click="ThemeToggleButton_Click"
                            Height="24" Padding="9,0" FontSize="11" Margin="0,0,12,0"
                            ToolTip="Switch between Microsoft Light and Dark Theme"/>
                    <TextBlock Text="v2.6.0 Enterprise" FontSize="11" Foreground="#DCEBFA" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ROW 1: MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: SYSTEM OVERVIEW -->
            <Border Grid.Column="0" Background="#F3F2F1" BorderBrush="#E1DFDD" BorderThickness="0,0,1,0" Padding="22,20">
                <DockPanel LastChildFill="True">
                    <!-- Enterprise Status Badge docked safely to bottom (never overlaps) -->
                    <Border DockPanel.Dock="Bottom" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#16A34A" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Corporate Network Active" FontSize="11.5" FontWeight="SemiBold" Foreground="#15803D"/>
                                <TextBlock Text="Enterprise deployment database link verified." FontSize="10.5" Foreground="#475569" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent">
                        <StackPanel>
                            <TextBlock Text="ENTERPRISE DEPLOYMENT SUITE" FontSize="10" FontWeight="Bold" Foreground="#0F6CBD" Margin="0,0,0,6"/>
                            <TextBlock Text="North American Store Infrastructure &amp; IT Rollout" FontSize="17" FontWeight="SemiBold" Foreground="#201F1E" TextWrapping="Wrap" LineHeight="23"/>
                            <TextBlock Text="Track store openings, low-voltage cabling, Wiremold 25DTP-4 power poles, dual-WAN telecom circuits, and NRF 4-5-4 fiscal calendar schedules."
                                       FontSize="11.5" Foreground="#605E5C" TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0"/>

                            <Separator Background="#E1DFDD" Margin="0,14"/>

                            <TextBlock Text="SYSTEM MODULES" FontSize="10" FontWeight="Bold" Foreground="#605E5C" Margin="0,0,0,8"/>

                            <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="1. Store Directory &amp; Specifications" FontSize="11.5" FontWeight="SemiBold" Foreground="#201F1E"/>
                                    <TextBlock Text="Site surveys, power poles, Cat6 drops, and WAN circuits" FontSize="10.5" Foreground="#605E5C" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="3" Padding="10,8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="2. NRF 4-5-4 Fiscal Calendar" FontSize="11.5" FontWeight="SemiBold" Foreground="#201F1E"/>
                                    <TextBlock Text="Daily TTU, circuit install, and multi-week progression" FontSize="10.5" Foreground="#605E5C" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FFFFFF" BorderBrush="#E1DFDD" BorderThickness="1" CornerRadius="3" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="3. Landlord Compliance Registry" FontSize="11.5" FontWeight="SemiBold" Foreground="#201F1E"/>
                                    <TextBlock Text="COI rules, after-hours mandates, and property contacts" FontSize="10.5" Foreground="#605E5C" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT PANE: MICROSOFT SIGN-IN CARD -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center" Width="380" HorizontalAlignment="Center">
                    <TextBlock Text="Sign in" FontSize="22" FontWeight="SemiBold" Foreground="#201F1E"/>
                    <TextBlock Text="Enter your corporate credentials to open the deployment workspace."
                               FontSize="12" Foreground="#605E5C" Margin="0,4,0,20"/>

                    <!-- Username -->
                    <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="#323130" Margin="0,0,0,4"/>
                    <TextBox x:Name="UsernameTextBox" Text="pm" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Password Header with Reset Link -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="#323130" VerticalAlignment="Center"/>
                        <Button Content="Forgot or Reset Password?" Click="ForgotPasswordButton_Click"
                                Background="Transparent" BorderThickness="0" Foreground="#0F6CBD"
                                Cursor="Hand" HorizontalAlignment="Right" FontSize="11" Padding="0"/>
                    </DockPanel>
                    <PasswordBox x:Name="PasswordBox" Password="pm123" Height="32" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Error Banner -->
                    <Border x:Name="ErrorBanner" Background="#FDE7E9" BorderBrush="#F1707B" BorderThickness="1" CornerRadius="2" Padding="10,7" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText" Text="Invalid username or password." Foreground="#A4262C" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Primary Action Button -->
                    <Button x:Name="LaunchButton" Content="Sign In" Click="SignInButton_Click"
                            IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Height="34" FontSize="13"/>

                    <!-- Reset Password Secondary Button -->
                    <Button x:Name="ResetPasswordButton" Content="🔑 Reset Password with Salt &amp; Pepper..." Click="ForgotPasswordButton_Click"
                            Height="30" FontSize="11.5" Margin="0,8,0,0" ToolTip="Reset your password using cryptographic Salt and Pepper"/>

                    <!-- Quick Role Switcher -->
                    <Border BorderBrush="#E1DFDD" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK ROLE PRESETS" FontSize="10.5" FontWeight="Bold" Foreground="#605E5C" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="PM (Admin)" Click="QuickLoginPM_Click" Height="28" FontSize="11.5"/>
                                <Button Grid.Column="2" Content="PA (Analyst)" Click="QuickLoginPA_Click" Height="28" FontSize="11.5"/>
                                <Button Grid.Column="4" Content="PS1 (Field Tech)" Click="QuickLoginTech_Click" Height="28" FontSize="11.5"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ROW 2: MICROSOFT STATUS BAR -->
        <Border Grid.Row="2" Background="#0078D4" Padding="16,0">
            <DockPanel>
                <TextBlock Text="Ready — Enterprise Fleet Environment (North American Deployment Division)" FontSize="11" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <TextBlock Text="NRF 4-5-4 Fiscal Calendar Enabled" FontSize="11" Foreground="#EBF3FC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
